{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid",
        ".validate": "$code.length >= 4 && $code.length <= 12",

        "hostId":    { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "createdAt": { ".validate": "newData.isNumber()" },

        "status": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'ended')"
        },

        "settings": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          ".validate": "newData.hasChildren()",
          "rounds":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 100" },
          "anonMode":   { ".validate": "newData.isBoolean()" },
          "is18Plus":   { ".validate": "newData.isBoolean()" },
          "pack":       { ".validate": "newData.isString() && newData.val().length <= 64" },
          "packName":   { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other":     { ".validate": false }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('hostId').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['name'])",
            "name":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "emoji":    { ".validate": "newData.isString() && newData.val().length <= 12" },
            "score":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && (newData.val() === 0 || root.child('rooms').child($code).child('hostId').val() === auth.uid)" },
            "isHost":   { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },

        "kicked": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "$uid": { ".validate": "newData.isBoolean() || newData.isString()" }
        },

        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['text'])",
            "text":           { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
            "name":           { ".validate": "newData.isString() && newData.val().length <= 40" },
            "senderId":       { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "sentAt":         { ".validate": "newData.isNumber()" },
            "isAnnouncement": { ".validate": "newData.isBoolean()" },
            "$other":         { ".validate": false }
          }
        },

        "submissions": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            "html":        { ".validate": "newData.isString() && newData.val().length <= 8000" },
            "text":        { ".validate": "newData.isString() && newData.val().length <= 8000" },
            "authorId":    { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "submittedAt": { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        },

        "votes": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 64"
          }
        },

        "leaderReactions": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "$targetId": {
            "$emojiIdx": {
              "$reactorId": {
                ".write": "auth != null && $reactorId === auth.uid",
                ".validate": "newData.isBoolean()"
              }
            }
          }
        },

        "reactions": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "$key": {
            ".write": "auth != null && !data.exists() && newData.child('playerId').val() === auth.uid",
            "playerId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "emoji":    { ".validate": "newData.isString() && newData.val().length <= 12" },
            "sentAt":   { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },

        "timer": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "active": { ".validate": "newData.isBoolean()" },
          "endsAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": true }
        },

        "game": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "phase":           { ".validate": "newData.isString() && newData.val().length <= 32" },
          "round":           { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
          "totalRounds":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
          "currentStoryIdx": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
          "packName":        { ".validate": "newData.isString() && newData.val().length <= 64" },
          "prompt":          { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "startedAt":       { ".validate": "newData.isNumber()" },
          "roundPrompts": {
            "$i": { ".validate": "newData.isString() && newData.val().length <= 1000" }
          },
          "stories": {
            "$i": {
              "authorId": { ".validate": "newData.isString() && newData.val().length <= 64" },
              "html":     { ".validate": "newData.isString() && newData.val().length <= 8000" },
              "text":     { ".validate": "newData.isString() && newData.val().length <= 8000" },
              "votes":    { ".validate": "newData.isNumber()" },
              "$other":   { ".validate": false }
            }
          },
          "storyVotes": {
            "$uid": { ".validate": "newData.isString() && newData.val().length <= 64" }
          },
          "scores": {
            "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" }
          },
          "$other": { ".validate": true }
        }
      }
    }
  }
}
